# .gitignore - Canaã Soluções Agrícolas

# Arquivos de configuração sensíveis
.env
.env.local
.env.*.local

# Sistema operacional
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE e Editor
.vscode/
.idea/
*.swp
*.swo
*~
.sublime-project
.sublime-workspace

# Dependências (se usar npm no futuro)
node_modules/
package-lock.json
yarn.lock

# Build e Dist
dist/
build/
*.zip

# Logs
*.log
logs/

# Backup
*.bak
*.backup
backup/

# Arquivos temporários
tmp/
temp/
*.tmp

# Credenciais e chaves
credentials.json
.ssh/

# Dados sensíveis
# (Deixe comentado se usar backup local)
# backups/*.json
